# Copy to .env for local overrides. Defaults already match `make up`.
KAFKA_BOOTSTRAP=localhost:19092
TOPIC_USER_EVENTS=user-events
TOPIC_IMPRESSIONS=impressions
TOPIC_EXPLAIN_REQUESTS=explain-requests

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=recsys-lake
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

MODELS_DIR=models
AB_TREATMENT_SHARE=0.5
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=items
MLFLOW_TRACKING_URI=./mlruns

SINK_BATCH_SIZE=500
SINK_FLUSH_INTERVAL_S=30
# LLM layer (provider: groq | openai-compatible). Put the real key in your shell, not in git.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_DAILY_BUDGET_USD=1.0

# Optional: protect GET /admin/stats (the dashboard sends it from ?token=...)
ADMIN_TOKEN=
