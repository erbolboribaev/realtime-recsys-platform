# Stage 1: build the shop and the dashboard (TypeScript + Vite).
FROM node:22-slim AS web
WORKDIR /web
COPY web/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY web ./
RUN npm run build

# Stage 2: the API, which also serves the built pages.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    WEB_DIR=/app/web \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY --from=web /web/dist ./web
RUN pip install ".[serve]"

RUN useradd --create-home appuser
USER appuser

EXPOSE 8000
CMD ["uvicorn", "--factory", "recsys.serving.app:create_app_from_env", "--host", "0.0.0.0", "--port", "8000"]
